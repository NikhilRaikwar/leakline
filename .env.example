FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_PASSWORD=
LEAKLINE_DATA=data
API_BASE_URL=http://127.0.0.1:8000
HF_HUB_DISABLE_IMPLICIT_TOKEN=1
# Maximum combined byte size of the four generated repair files (16 MiB default).
MAX_REPAIR_ARTIFACT_BYTES=16777216
# OpenRouter credentials remain server-side; choose a model with tool-calling support.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
AGENT_MAX_STEPS=16
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_TOOL_RESULT_ROWS=100
